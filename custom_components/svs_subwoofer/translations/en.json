      "no_device": "No device information available"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Connection Options",
        "description": "Choose how the integration handles the Bluetooth connection. \"Disconnect when idle\" disconnects after 60 seconds without commands, so the SVS app can connect. \"Stay connected\" keeps the connection open and asks the subwoofer for its settings every 30 seconds, reconnecting if it stops answering; on some subwoofers this briefly lights the panel LEDs each time. \"Stay connected quietly\" keeps the connection open with a standard Bluetooth read every 30 seconds that the subwoofer's control software does not see; whether the subwoofer still answers is checked before each command. Use the Disconnect button when you need the SVS app.",
        "data": {
          "connection_mode": "Connection"
        }
      }
    }
  },
